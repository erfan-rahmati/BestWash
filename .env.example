NODE_ENV=production
PORT=3001
POSTGRES_DB=bestwash
POSTGRES_USER=bestwash
POSTGRES_PASSWORD=change-this-long-database-password
DATABASE_URL=postgresql://bestwash:change-this-long-database-password@postgres:5432/bestwash?schema=public
REDIS_PASSWORD=change-this-long-redis-password
REDIS_URL=redis://:change-this-long-redis-password@redis:6379/0
WEB_ORIGIN=https://bestwash.example
NEXT_PUBLIC_WEB_URL=https://bestwash.example
NEXT_PUBLIC_API_BASE_URL=https://bestwash.example/api/v1
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
API_PUBLIC_URL=https://bestwash.example
JWT_ACCESS_SECRET=generate-at-least-64-random-characters
JWT_ADMIN_SECRET=generate-another-at-least-64-random-characters
OTP_PEPPER=generate-another-at-least-64-random-characters
MESSAGE_SECRET_ENCRYPTION_KEY=generate-another-at-least-64-random-characters
PAYMENT_PROVIDER=zarinpal
ZARINPAL_SANDBOX=true
ZARINPAL_MERCHANT_ID=00000000-0000-4000-8000-000000000001
PAYMENT_CALLBACK_URL=https://bestwash.example/api/v1/payments/zarinpal/callback
SMSIR_API_KEY=your-sms-ir-api-key
SMSIR_TEMPLATE_AUTH_OTP=000000
SMSIR_TEMPLATE_ADMIN_LOGIN_OTP=000000
SMSIR_TEMPLATE_ADMIN_BROADCAST=000000
SMSIR_TEMPLATE_PAYMENT_LINK=000000
SMSIR_TEMPLATE_BOOKING_CONFIRMED=000000
SMSIR_TEMPLATE_PICKUP_CODE_OWNER=000000
SMSIR_TEMPLATE_PICKUP_CODE_DELEGATE=000000
SMSIR_TEMPLATE_PICKUP_DELEGATE_CHANGED=000000
SMSIR_TEMPLATE_PICKUP_REMINDER_OWNER=000000
ADMIN_INITIAL_USERNAME=bestwash_owner
ADMIN_INITIAL_MOBILE=09120000000
ADMIN_INITIAL_EMAIL=admin@bestwash.ir
ADMIN_INITIAL_PASSWORD=replace-before-first-deploy
BUSINESS_TIMEZONE=Asia/Tehran
BOOKING_WINDOW_DAYS=14
MIN_BOOKING_LEAD_MINUTES=30
CAPACITY_BUCKET_MINUTES=15
BOOKING_HOLD_MINUTES=8
BOOKING_OVERLAP_TOLERANCE_MINUTES=10
CASHBACK_PERCENT=10
CASHBACK_EXPIRY_DAYS=90
EXPOSE_TEST_OTP=false
WEB_PUSH_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_PRIVATE_KEY=replace-with-vapid-private-key
WEB_PUSH_SUBJECT=mailto:support@bestwash.example
