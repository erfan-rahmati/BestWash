FROM node:24-alpine AS build
RUN corepack enable
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/worker/package.json apps/worker/package.json
RUN pnpm install --frozen-lockfile --filter worker...
COPY apps/worker apps/worker
RUN pnpm --filter worker build

FROM node:24-alpine AS runtime
RUN addgroup -S bestwash && adduser -S bestwash -G bestwash
WORKDIR /app/apps/worker
ENV NODE_ENV=production
COPY --from=build --chown=bestwash:bestwash /app/node_modules /app/node_modules
COPY --from=build --chown=bestwash:bestwash /app/apps/worker/node_modules ./node_modules
COPY --from=build --chown=bestwash:bestwash /app/apps/worker/package.json ./package.json
COPY --from=build --chown=bestwash:bestwash /app/apps/worker/dist ./dist
USER bestwash
CMD ["node", "dist/main.js"]
